@{
    ViewData["Title"] = "Jquery-confirm";

    bool useFontAwesome = true; // Altere para false para usar ícones do Bootstrap

    string classSuccess = useFontAwesome ? "fa-regular fa-circle-check" : "bi bi-check-circle-fill";
    string classError = useFontAwesome ? "fa-regular fa-circle-xmark" : "bi bi-exclamation-triangle-fill";
    string classWarning = useFontAwesome ? "fa-solid fa-triangle-exclamation" : "bi bi-exclamation-circle-fill";
    string classInfo = useFontAwesome ? "fa-solid fa-circle-info" : "bi bi-info-circle-fill";
}

<div class="border-bottom mb-3">
    <h3>@ViewData["Title"]</h3>
</div>

<div class="row">
    <div class="col-12">
        <a asp-area="" asp-controller="Modal" asp-action="JqueryConfirmSuccess" class="btn btn-success">Success</a>
        <a asp-area="" asp-controller="Modal" asp-action="JqueryConfirmError" class="btn btn-danger">Error</a>
        <a asp-area="" asp-controller="Modal" asp-action="JqueryConfirmInfo" class="btn btn-info text-white">Information</a>
        <a asp-area="" asp-controller="Modal" asp-action="JqueryConfirmWarning" class="btn btn-warning text-white">Warning</a>
    </div>
</div>

<form id="formLogout" action="@Url.Action("RedirecionarErro", "Modal")" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

@if (ViewData["Success"] != null || ViewData["Error"] != null || ViewData["Warning"] != null || ViewData["Info"] != null)
{
    @section Scripts {
        <script type="text/javascript">
            function configureAlerts(){
                var defaultConfig = {
                    theme: 'modern',
                    typeAnimated: true,
                    animation: 'scale',
                    closeAnimation: 'scale'
                };

                @if (ViewData["Success"] != null)
                {
                    <text>
                        $.alert($.extend({}, defaultConfig, {
                            icon: '@classSuccess',
                            title: 'Sucesso',
                            content: '@ViewData["Success"]',
                            type: 'green',
                            buttons: {
                                ok: {
                                    text: 'Fechar',
                                    btnClass: 'btn-green'
                                }
                            }
                        }));
                    </text>
                }
            
                @if (ViewData["Error"] != null)
                {
                    <text>
                        $.alert($.extend({}, defaultConfig, {
                            icon: '@classError',
                            title: 'Acesso Negado',
                            content: '@ViewData["Error"]',
                            type: 'red',
                            buttons: {
                                ok: {
                                    text: 'Encerrar Acesso',
                                    btnClass: 'btn-red',
                                    action: function() {
                                        this.buttons.ok.setText('<span class="spinner-border spinner-border-sm"></span> Processando...');
                                        this.buttons.ok.disable();

                                        $('#formLogout').submit();

                                        return false;
                                    }
                                }
                            }
                        }));
                    </text>
                }

                @if (ViewData["Warning"] != null)
                {
                    <text>
                        $.alert($.extend({}, defaultConfig, {
                            icon: '@classWarning',
                            title: 'Atenção',
                            content: '@ViewData["Warning"]',
                            type: 'orange',
                            buttons: {
                                ok: {
                                    text: 'Entendi',
                                    btnClass: 'btn-orange'
                                }
                            }
                        }));
                    </text>
                }

                @if (ViewData["Info"] != null)
                {
                    <text>
                        $.alert($.extend({}, defaultConfig, {
                            icon: '@classInfo',
                            title: 'Informação',
                            content: '@ViewData["Info"]',
                            type: 'blue',
                            buttons: {
                                ok: {
                                    text: 'OK',
                                    btnClass: 'btn-blue'
                                }
                            }
                        }));
                    </text>
                }
            }

            $(document).ready(function () {
                configureAlerts();
            });
        </script>
    }
}