@{
    ViewData["Title"] = "Bootbox.js";

    bool useFontAwesome = true; // Altere para false para usar ícones do Bootstrap

    string classSuccess = useFontAwesome ? "fa-regular fa-circle-check" : "bi bi-check-circle-fill";
    string classError = useFontAwesome ? "fa-regular fa-circle-xmark" : "bi bi-exclamation-triangle-fill";
    string classWarning = useFontAwesome ? "fa-solid fa-triangle-exclamation" : "bi bi-exclamation-circle-fill";
    string classInfo = useFontAwesome ? "fa-solid fa-circle-info" : "bi bi-info-circle-fill";
}

<div class="border-bottom mb-3">
    <h3>@ViewData["Title"]</h3>
</div>

<div class="row">
    <div class="col-12">
        <a asp-area="" asp-controller="Modal" asp-action="BootboxJsSuccess" class="btn btn-success">Success</a>
        <a asp-area="" asp-controller="Modal" asp-action="BootboxJsError" class="btn btn-danger">Error</a>
        <a asp-area="" asp-controller="Modal" asp-action="BootboxJsInfo" class="btn btn-info text-white">Information</a>
        <a asp-area="" asp-controller="Modal" asp-action="BootboxJsWarning" class="btn btn-warning text-white">Warning</a>
    </div>
</div>

<form id="formLogout" action="@Url.Action("RedirecionarErro", "Modal")" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

@if (ViewData["Success"] != null || ViewData["Error"] != null || ViewData["Warning"] != null || ViewData["Info"] != null)
{
    @section Scripts {
        <script type="text/javascript">
            function configureAlerts() {
                @if (ViewData["Success"] != null)
                {
                    <text>
                        bootbox.alert({
                            title: "<span class='text-success'><i class='@classSuccess me-2'></i>Sucesso</span>",
                            message: "@ViewData["Success"]",
                            centerVertical: true,
                            buttons: {
                                ok: {
                                    label: 'Fechar',
                                    className: 'btn-success'
                                }
                            }
                        });
                    </text>
                }
            
                @if (ViewData["Error"] != null)
                {
                    <text>
                        bootbox.alert({
                            title: "<span class='text-danger fs-5'><i class='@classError me-2'></i>Acesso Negado</span>", // Bootstrap icons
                            message: "@ViewData["Error"]",
                            centerVertical: true,
                            closeButton: false,
                            backdrop: 'static',
                            buttons: {
                                ok: {
                                    label: 'Encerrar Acesso',
                                    className: 'btn-danger btn-sair-modal px-4'
                                }
                            },
                            callback: function() {
                                var btnSair = $(this).find('.btn-sair-modal');

                                btnSair.prop('disabled', true);
                                btnSair.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processando...');

                                $('#formLogout').submit();

                                return false;
                            }
                        });
                    </text>
                }

                @if (ViewData["Warning"] != null)
                {
                    <text>
                        bootbox.alert({
                            title: "<span class='text-warning'><i class='@classWarning me-2'></i>Atenção</span>", // Bootstrap icons
                            message: "@ViewData["Warning"]",
                            centerVertical: true,
                            buttons: {
                                ok: {
                                    label: 'Entendi',
                                    className: 'btn-warning text-white'
                                }
                            }
                        });
                    </text>
                }

                @if (ViewData["Info"] != null)
                {
                    <text>
                        bootbox.alert({
                            title: "<span class='text-info'><i class='@classInfo me-2'></i>Informação</span>", // Bootstrap icons
                            message: "@ViewData["Info"]",
                            centerVertical: true,
                            buttons: {
                                ok: {
                                    label: 'OK',
                                    className: 'btn-info text-white'
                                }
                            }
                        });
                    </text>
                }
            }
            
            $(document).ready(function () {
                configureAlerts();
            });
        </script>
    }
}